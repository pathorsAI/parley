    "When the network drops, the server goes quiet, or you run out of quota, the phone holds on to finished recordings until they sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the network drops, the server goes quiet, or you run out of quota, the phone holds on to finished recordings until they sync."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路中斷、伺服器暫時無回應或額度不足時，手機會保留完成的錄音，直到同步成功。"
          }
        }
      }
    },
