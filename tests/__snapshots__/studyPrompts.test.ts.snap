exports[`study prompts — presets and filler words > buildBuiltinEvalLabels (en) 1`] = `
{
  "batna": {
    "description": "Each side's walk-away alternative — the real source of leverage",
    "name": "BATNA",
  },
  "checklist": {
    "description": "Standard topics for this meeting type that haven't been covered yet",
    "name": "Process gaps",
  },
  "claims": {
    "description": "Verifiable factual claims by the other party, flagged to check later",
    "name": "Claims to verify",
  },
  "criteria": {
    "description": "Decide terms by objective standards, not will or pressure",
    "name": "Objective criteria",
  },
  "deception": {
    "description": "Bad-faith manipulation, evasion, exaggeration, or pressure tactics from the other party",
    "name": "Deception",
  },
  "in-blocked": {
    "description": "Work waiting on someone else, and blockers nobody was assigned to clear",
    "name": "Dependencies and blockers",
  },
  "in-scope": {
    "description": "Additions folded into existing work with no cost weighed and no date moved",
    "name": "Scope creep",
  },
  "in-undecided": {
    "description": "Things the room treated as settled without actually settling them",
    "name": "False consensus",
  },
  "in-unowned": {
    "description": "Follow-ups the meeting created with no named owner or deadline",
    "name": "Unowned work",
  },
  "inconsistency": {
    "description": "Genuine self-contradictions in what the other party said (not a stated change or a constraint)",
    "name": "Inconsistency",
  },
  "leverage": {
    "description": "Trades on differently-valued issues that expand the pie",
    "name": "Options for mutual gain",
  },
  "nextmove": {
    "description": "Based on progress so far, what to say / ask / propose next",
    "name": "Next move",
  },
  "ng-concessions": {
    "description": "Concessions and terms each side has offered or agreed to",
    "name": "Concession tracking",
  },
  "pushback": {
    "description": "One-sided terms, or vague over-promising / blurred focus you should pin down",
    "name": "When to push back",
  },
  "rv-commitment": {
    "description": "ME committing to something concrete against a deliberately vague answer",
    "name": "Lopsided commitments",
  },
  "rv-leak": {
    "description": "Information ME volunteered that a competitor can use, with nothing comparable back",
    "name": "What we gave away",
  },
  "rv-probing": {
    "description": "Questions about MY costs, customers, or capacity that go beyond this deal",
    "name": "They're fishing",
  },
  "sl-objections": {
    "description": "Objections or concerns they raise, flagging any not yet addressed",
    "name": "Objections",
  },
  "sl-pain": {
    "description": "Whether their pain is specific, quantified, and urgent",
    "name": "Pain depth & urgency",
  },
  "sl-qualification": {
    "description": "MEDDICC dimensions still unclear: Metrics, economic buyer, decision criteria, pain, process, Champion",
    "name": "Qualification gaps (MEDDICC)",
  },
  "topic-shift": {
    "description": "Them changing the subject, answering a different question, or burying your point in irrelevant detail",
    "name": "Topic drift",
  },
  "unanswered": {
    "description": "Questions I asked that they dodged or never answered directly",
    "name": "Unanswered questions",
  },
  "zopa": {
    "description": "The overlap of acceptable ranges — is an offer inside the zone",
    "name": "Zone of agreement",
  },
}
`;

