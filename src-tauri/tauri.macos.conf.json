{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Parley",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundThrottling": "disabled",
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ]
  },
  "bundle": {
    "resources": ["onnxruntime/libonnxruntime.dylib"]
  }
}
