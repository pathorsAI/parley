      {
        "builtin": true,
        "id": "todo-interview",
        "items": [
          "Introduce yourself and the role",
          "Ask the candidate about their background and motivation",
          "Dig into one representative project",
          "Verify core technical skills / abilities",
          "Ask about past conflicts and how they handled them",
          "Leave time for the candidate's questions",
          "Confirm salary expectations and start date",
          "Explain next steps and timeline",
        ],
        "name": "Job interview",
      },
      {
        "builtin": true,
        "id": "todo-salary",
        "items": [
          "Let them put out a number / range first",
          "Cover the full package: base, bonus, equity, sign-on, benefits",
          "State your value with market-rate evidence",
          "Propose a justified target number (anchor)",
          "Clarify equity terms (amount, valuation, vesting)",
          "Confirm promotion / raise timeline and criteria",
          "Handle pressure or artificial deadlines",
          "Get a written offer and time to consider",
        ],
        "name": "Salary negotiation",
      },
      {
        "builtin": true,
        "id": "todo-sales-discovery",
        "items": [
          "Confirm their role and decision authority",
          "Understand the current situation and approach",
          "Uncover the core pain and its impact",
          "Quantify the cost / loss of the pain",
          "Confirm the budget range",
          "Clarify the decision process and key people",
          "Understand timeline and urgency",
          "Ask about existing solutions / competitors",
          "Agree on a concrete next step",
        ],
        "name": "Sales call",
      },
      {
        "builtin": true,
        "id": "todo-deal",
        "items": [
          "Confirm both sides' goals and walk-away (BATNA)",
          "Clarify what they truly prioritize",
          "Map out the variables: price, terms, timeline",
          "Agree on the overall framework before details",
          "Trade every concession for something of equal value",
          "Record what's agreed and what's still open",
          "Confirm the decision process and signing timeline",
          "Summarize agreements and set the next step",
        ],
        "name": "Deal-making",
      },
      {
        "builtin": true,
        "id": "todo-diligence",
        "items": [
          "Confirm core financials and growth trends",
          "Understand revenue mix and customer concentration",
          "Check retention / churn and unit economics",
          "Clarify competitive and market risks",
          "Confirm the team, key people, and cap table",
          "Review legal / compliance / IP status",
          "Ask about tech debt and security posture",
          "Request supporting documents and set a follow-up",
        ],
        "name": "Diligence call",
      },
      {
        "builtin": true,
        "id": "todo-coffee-chat",
        "items": [
          "Briefly introduce yourself and why you're here",
          "Ask about their startup journey and key turning points",
          "Ask about their biggest current challenge",
          "Get their take on my current direction",
          "Ask about common pitfalls and advice",
          "Ask who's worth meeting / for intros",
          "Ask for recommended resources or books",
          "Agree on how to follow up next",
        ],
        "name": "Coffee chat (founder mentor)",
