                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "filler_level": {
                "description": "'frequent' ONLY when filler words / verbal tics are dense enough in a short stretch to distract (e.g. many in a sentence or two). Everyone uses some fillers — never flag mere presence; default to 'ok'.",
                "enum": [
                  "ok",
                  "frequent",
                ],
                "type": "string",
              },
              "filler_note": {
                "description": "One short line about the over-frequent stretch (where/what); empty when level is 'ok'.",
                "type": "string",
              },
              "pace": {
                "description": "How fast the user is speaking overall.",
