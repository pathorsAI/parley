<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AutoSync: drain the upload and re-transcription queues when a validated network returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14+: be told when the user screenshots Parley, to offer "Report this
         screen?" (feedback/FeedbackCenter.screenshotTaken). A normal permission, granted
         at install; it reveals only that a capture happened, never the image. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application
        android:name=".ParleyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Parley">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Cloud sign-in hand-off: https://api.parley.tw/sign-in?to=parley://auth-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="parley" android:host="auth-callback" />
                <!-- Store-screenshot demo mode (debug builds only, see DemoMode):
                     adb shell am start -a android.intent.action.VIEW \
                       -d "'parley://demo/library'" -->
                <data android:scheme="parley" android:host="demo" />
            </intent-filter>
        </activity>

        <service
            android:name=".meeting.MeetingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Hears that "Share to AI" reached a share target (the getting-started
             checklist's last item). Only the chooser's own PendingIntent reaches
             it, so it is not exported. -->
        <receiver
            android:name=".ui.HandoffShareReceiver"
            android:exported="false" />

        <!-- ── Voice typing (the Parley keyboard) ──────────────────────────────

             The input method itself. `exported="true"` and the
             BIND_INPUT_METHOD permission go together and are not optional: the
             system's InputMethodManagerService is a different process and has to
             bind this, and requiring the signature-level BIND_INPUT_METHOD is
             what stops anything *else* from doing so. An exported IME service
             without that permission would let any app on the device drive the
             keyboard.

             The `android.view.im` meta-data points at res/xml/method.xml, which
             carries the subtype and the settings link. -->
        <service
            android:name=".ime.ParleyInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Holds the microphone for one dictation. An input method is never the
             top app, and since Android 11 an app that is not the top app and has
             no microphone-typed foreground service is fed silence rather than an
             error — so without this, voice typing would transcribe nothing and
             look like it was working. See DictationService for the background-
             start exemption that makes it legal. -->
        <service
            android:name=".ime.DictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The keyboard's settings screen, and the only place on the voice-typing
             path where RECORD_AUDIO can be requested: a runtime permission dialog
             needs an Activity, and an InputMethodService has none.

             `exported="true"` is required, not incidental. This is the activity
             method.xml names as `android:settingsActivity`, and the system
             Settings app launches it *by component name from its own process*
             when the user taps Parley in the keyboard list — a non-exported
             activity refuses that with a SecurityException, and the row in
             system settings silently does nothing. Exporting it is safe here:
             it takes no intent extras, reads nothing from the caller, and does
             nothing an app could not do by opening its own settings — it shows
             two toggles and asks for a permission the user must grant by hand.
             No intent-filter, so it is reachable only by explicit component. -->
        <activity
            android:name=".ime.VoiceTypingSettingsActivity"
            android:exported="true"
            android:label="@string/ime_settings_title"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
    </application>
</manifest>
