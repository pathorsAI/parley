<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher shortcut's icon (xml/shortcuts.xml): the microphone in recording
     red on the launcher icon's white, as an adaptive icon so launchers mask it to
     the same shape as their other shortcut icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_record_foreground" />
</adaptive-icon>
