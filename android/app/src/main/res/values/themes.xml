<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists only to dress the window before Compose takes over: the
  activity is a single Compose surface, so all real styling lives in
  ui/theme/Theme.kt (Material 3, Parley's own palette and faces — no dynamic
  color; see the rationale in that file).

  Parent is a platform DayNight theme rather than a Material Components one:
  the app deliberately has no `com.google.android.material` dependency.

  `windowBackground` is what shows through the transparent system bars, and it
  is `colorBackground` only for the handful of frames before Compose runs. From
  then on ParleyTheme overwrites it with the scheme's own background, because
  the app's appearance can now differ from the device's and this attribute
  cannot: it resolves against the configuration's night mode, not ours.
-->
<resources>
    <style name="Theme.Parley" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
